{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dentview config",
  "type": "object",
  "required": ["title", "meshes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "description": "Заголовок вьюера. Без ФИО пациента, если файл уходит за пределы клиники." },
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "kind"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "description": "Путь к STL, относительный – от каталога конфига" },
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "description": "По умолчанию – имя файла без расширения" },
          "name": { "type": "string", "description": "Подпись в UI, по умолчанию = id" },
          "kind": { "enum": ["anatomy", "bone", "implant", "abutment", "sleeve", "waxup"] },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "visible": { "type": "boolean" },
          "shading": { "enum": ["smooth", "flat", "crease"], "description": "По умолчанию crease для implant/abutment/sleeve, иначе smooth" },
          "crease_deg": { "type": "number", "minimum": 0, "maximum": 180 },
          "transform": {
            "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "number" },
            "description": "4×4 row-major, применяется к мешу во вьюере"
          }
        }
      }
    }
  }
}

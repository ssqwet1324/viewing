<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="dentview">
<title>{{.Title}}</title>
<style>
html,body{margin:0;height:100%;background:#17181c;color:#e6e7eb;font:14px system-ui,sans-serif}
#boot{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;white-space:pre-wrap;text-align:center;padding:16px}
</style>
</head>
<body>
<div id="boot">Загрузка…</div>
{{range .Blobs}}<script type="application/gzip" id="{{.ID}}">{{.Base64}}</script>
{{end}}<script>
(async () => {
  if (typeof DecompressionStream === "undefined") throw new Error("Браузер устарел: нужен Chrome/Edge 80+, Firefox 113+ или Safari 16.4+.");
  const b64 = document.getElementById("dv-viewer").textContent.trim();
  const bin = Uint8Array.fromBase64 ? Uint8Array.fromBase64(b64) : Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  const js = await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream("gzip"))).text();
  const s = document.createElement("script");
  s.src = URL.createObjectURL(new Blob([js], { type: "text/javascript" }));
  s.onerror = () => { document.getElementById("boot").textContent = "Не удалось запустить вьюер."; };
  document.body.append(s);
})().catch(e => { document.getElementById("boot").textContent = "Ошибка загрузки: " + e.message; });
</script>
</body>
</html>
